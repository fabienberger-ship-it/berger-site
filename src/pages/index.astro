---
import BaseLayout from '../layouts/BaseLayout.astro';

const associates = [
  { name: 'Fabien Berger', role: 'Associé fondateur', mailto: 'fabien.berger@berger-associes.fr' },
  { name: 'Sabine Tellier', role: 'Associée', mailto: 'sabine.tellier@berger-associes.fr' },
  { name: 'Marine Gorin', role: 'Associée', mailto: 'marine.gorin@berger-associes.fr' },
];
---

<BaseLayout
  title="Berger & Associés — Conseil en gestion de patrimoine, Paris"
  description="Berger & Associés, cabinet indépendant de conseil en gestion de patrimoine à Paris. Trois associés. Fondé en 2013."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">
        <span class="rule-gold" aria-hidden="true"></span>
        Cabinet indépendant · Paris
      </p>

      <h1 class="hero__title editorial">Conseil en gestion de patrimoine.</h1>

      <p class="hero__lead">
        Berger &amp; Associés est un cabinet indépendant fondé en 2013. Trois associés
        accompagnent particuliers et familles dans la durée. Notre clientèle nous est
        adressée par recommandation.
      </p>

      <div class="hero__actions">
        <a href="mailto:contact@berger-associes.fr" class="btn btn--navy">Nous contacter</a>
      </div>
    </div>
  </section>

  <div class="container">
    <ul class="credentials" aria-label="Agréments du cabinet">
      <li>Depuis 2013</li>
      <li>ORIAS n° 13004419</li>
      <li>Membre CNCGP</li>
      <li>Sous contrôle ACPR / AMF</li>
    </ul>
  </div>

  <section class="associates" id="associes">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">
          <span class="rule-gold" aria-hidden="true"></span>
          Le cabinet
        </p>
        <h2 class="section-head__title editorial">Les associés</h2>
      </header>

      <ul class="masthead">
        {associates.map(({ name, role, mailto }) => (
          <li class="masthead__row">
            <h3 class="masthead__name editorial">{name}</h3>
            <p class="masthead__role">{role}</p>
            <p class="masthead__email">
              <a href={`mailto:${mailto}`}>{mailto}</a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="container contact__inner">
      <div class="contact__intro">
        <p class="eyebrow">
          <span class="rule-gold" aria-hidden="true"></span>
          Contact
        </p>
        <h2 class="contact__title editorial">Nous rencontrer</h2>
        <p class="contact__text">
          Le premier rendez-vous se tient à notre cabinet ou en visioconférence. Il est sans
          engagement : nous définissons ensemble le périmètre de votre demande avant toute mission.
        </p>
      </div>

      <dl class="contact__details">
        <div>
          <dt>Email</dt>
          <dd><a href="mailto:contact@berger-associes.fr">contact@berger-associes.fr</a></dd>
        </div>
        <div>
          <dt>Adresse</dt>
          <dd>96 boulevard Sébastopol<br>75003 Paris</dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* ————— Hero ————— */
  .hero {
    padding-block: clamp(var(--s-6), 12vh, calc(var(--s-7) + var(--s-5))) var(--s-6);
  }

  .hero .eyebrow { margin-bottom: var(--s-3); }

  .hero__title {
    font-size: clamp(var(--fs-3xl), 6.5vw, var(--fs-4xl));
    line-height: var(--lh-tight);
    letter-spacing: -0.025em;
    color: var(--c-fg);
    margin-bottom: var(--s-3);
    font-weight: 600;
    max-width: 18ch;
    text-wrap: balance;
  }

  .hero__lead {
    font-size: clamp(var(--fs-base), 1.8vw, var(--fs-lg));
    line-height: var(--lh-loose);
    color: var(--c-fg-muted);
    max-width: 560px;
    margin-bottom: var(--s-5);
  }

  /* ————— Agréments ————— */
  .credentials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    padding-block: var(--s-3);
    border-block: 1px solid var(--c-divider);
    font-size: var(--fs-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  /* ————— Sections ————— */
  .section-head { margin-bottom: var(--s-5); }

  .section-head__title,
  .contact__title {
    font-size: clamp(var(--fs-2xl), 4vw, var(--fs-3xl));
    font-weight: 600;
    margin-top: var(--s-2);
  }

  /* ————— Les associés — liste typographique ————— */
  .associates {
    padding-block: var(--s-7) var(--s-6);
  }

  .masthead {
    list-style: none;
    border-top: 1px solid var(--c-divider);
  }

  .masthead__row {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr auto;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-divider);
  }

  .masthead__name {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .masthead__role {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-accent);
  }

  .masthead__email {
    font-size: var(--fs-sm);
    justify-self: end;
  }

  .masthead__email a {
    color: var(--c-fg-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .masthead__email a:hover { color: var(--c-fg); opacity: 1; }

  /* ————— Contact ————— */
  .contact {
    border-top: 1px solid var(--c-divider);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--s-6);
    padding-block: var(--s-6) var(--s-7);
  }

  .contact__title { margin-bottom: var(--s-3); }

  .contact__text {
    color: var(--c-fg-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-loose);
    max-width: 480px;
  }

  .contact__details {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    padding-top: calc(var(--s-2) + 2.4rem); /* aligne sur le titre, sous l'eyebrow */
  }

  .contact__details dt {
    font-size: var(--fs-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 0.3rem;
  }

  .contact__details dd {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--c-fg);
  }

  .contact__details dd a {
    color: var(--c-fg);
    text-decoration-color: rgba(20, 35, 58, 0.3);
  }

  /* ————— Responsive ————— */
  @media (max-width: 720px) {
    .masthead__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .masthead__email { justify-self: start; }
    .contact__inner { grid-template-columns: 1fr; gap: var(--s-4); }
    .contact__details { padding-top: 0; }
  }
</style>
