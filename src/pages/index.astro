---
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import fabienPortrait from '../assets/fabien-berger.webp';
import sabinePortrait from '../assets/sabine-tellier.webp';

const associates = [
  { name: 'Fabien Berger', role: 'Associé fondateur', mailto: 'fabien.berger@berger-associes.fr' },
  { name: 'Sabine Tellier', role: 'Associée', mailto: 'sabine.tellier@berger-associes.fr' },
  { name: 'Marine Gorin', role: 'Associée', mailto: 'marine.gorin@berger-associes.fr' },
];
---

<BaseLayout
  title="Berger & Associés — Conseil en gestion de patrimoine, Paris"
  description="Berger & Associés, cabinet indépendant de conseil en gestion de patrimoine à Paris. Trois associés. Fondé en 2013."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container-wide hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">Conseil en gestion de patrimoine · Paris</p>
        <h1 id="hero-title" class="hero__title editorial">L’humain,<br><em>avant tout.</em></h1>
        <p class="hero__lead">Un patrimoine se construit autour d’une vie. Depuis 2013, nous accompagnons les particuliers, les familles et les dirigeants dans leurs décisions patrimoniales.</p>
        <a href="#contact" class="button-link">Rencontrons-nous <span aria-hidden="true">↗</span></a>
        <p class="hero__signature">Un cabinet indépendant. Une relation directe.</p>
      </div>
      <div class="hero__portraits" aria-label="Portraits de Fabien Berger et Sabine Tellier">
        <figure class="hero__portrait hero__portrait--fabien">
          <Image src={fabienPortrait} alt="Fabien Berger, associé fondateur" widths={[360, 600, 900]} sizes="(max-width: 700px) 45vw, 24vw" width={600} format="webp" loading="eager" fetchpriority="high" />
          <figcaption><span>Fabien Berger</span><span>Associé fondateur</span></figcaption>
        </figure>
        <figure class="hero__portrait hero__portrait--sabine">
          <Image src={sabinePortrait} alt="Sabine Tellier, associée" widths={[360, 600, 900]} sizes="(max-width: 700px) 45vw, 24vw" width={600} format="webp" loading="eager" />
          <figcaption><span>Sabine Tellier</span><span>Associée</span></figcaption>
        </figure>
      </div>
    </div>
    <div class="container-wide hero__baseline"><span>À vos côtés, depuis 2013</span><a href="#cabinet">Découvrir le cabinet <span aria-hidden="true">↓</span></a></div>
  </section>


  <section class="cabinet" id="cabinet" aria-labelledby="cabinet-title">
    <div class="container-wide cabinet__inner">
      <div>
        <p class="eyebrow eyebrow--light">Le cabinet</p>
        <h2 id="cabinet-title" class="section-title">Prendre le temps<br>de vous connaître.</h2>
      </div>
      <div class="cabinet__text">
        <p class="cabinet__lead">Avant les chiffres, il y a vos projets, vos proches et vos choix de vie.</p>
        <p>Fondé par Fabien Berger en 2013, notre cabinet réunit aujourd’hui trois associés. Nous vous accueillons au cœur de Paris pour comprendre votre situation et construire avec vous une approche patrimoniale d’ensemble.</p>
        <p>Nos clients viennent à nous par recommandation. Cette confiance nous engage : prendre le temps d’expliquer, rester disponibles et vous accompagner au fil des années.</p>
        <a href="#associes" class="text-link text-link--light">Faire connaissance <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="container-wide cabinet__facts">
      <div><span class="cabinet__fact-value">2013</span><span>L’année de création</span></div>
      <div><span class="cabinet__fact-value">Trois</span><span>Associés à vos côtés</span></div>
      <div><span class="cabinet__fact-value">Paris</span><span>96 boulevard Sébastopol</span></div>
    </div>
  </section>

  <section class="expertise section-space" aria-labelledby="expertise-title">
    <div class="container-wide">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Vos projets</p>
          <h2 id="expertise-title" class="section-title">Les décisions<br>qui comptent pour vous.</h2>
        </div>
        <p class="section-heading__aside">Chaque situation appelle une réflexion particulière. Nous relions les dimensions financières, familiales et professionnelles de votre patrimoine.</p>
      </div>
      <div class="expertise__grid">
        <article class="expertise__item">
          <span class="section-number" aria-hidden="true">01</span>
          <div><h3>Investir avec une vision d’ensemble</h3><p>Mettre en perspective votre épargne, vos investissements et votre patrimoine immobilier, selon vos objectifs et votre horizon.</p></div>
        </article>
        <article class="expertise__item">
          <span class="section-number" aria-hidden="true">02</span>
          <div><h3>Protéger ceux qui comptent</h3><p>Faire le point sur votre prévoyance et les dispositions qui protègent votre famille face aux aléas de la vie.</p></div>
        </article>
        <article class="expertise__item">
          <span class="section-number" aria-hidden="true">03</span>
          <div><h3>Préparer la suite</h3><p>Anticiper la retraite, une évolution professionnelle ou la cession d’une entreprise et leurs conséquences patrimoniales.</p></div>
        </article>
        <article class="expertise__item">
          <span class="section-number" aria-hidden="true">04</span>
          <div><h3>Organiser la transmission</h3><p>Réfléchir à ce que vous souhaitez transmettre, à qui et dans quelles conditions, en lien avec vos conseils habituels.</p></div>
        </article>
      </div>
    </div>
  </section>

  <section class="approach section-space" id="approche" aria-labelledby="approach-title">
    <div class="container-wide">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Notre approche</p>
          <h2 id="approach-title" class="section-title">Écouter. Éclairer.<br>Accompagner.</h2>
        </div>
        <p class="section-heading__aside">Vous restez au centre des décisions.<br>Notre rôle est de vous donner les éléments pour les prendre.</p>
      </div>
      <ol class="approach__steps">
        <li>
          <span class="approach__step-label">Un premier échange</span>
          <h3>Comprendre<br>votre situation.</h3>
          <p>Nous faisons connaissance et prenons le temps d’écouter vos attentes. Ensemble, nous définissons le périmètre de votre demande.</p>
        </li>
        <li>
          <span class="approach__step-label">Une réflexion partagée</span>
          <h3>Mettre les choix<br>en perspective.</h3>
          <p>Nous analysons votre patrimoine et vous expliquons les solutions envisagées, leurs caractéristiques, leurs risques et leur rémunération.</p>
        </li>
        <li>
          <span class="approach__step-label">Une relation dans la durée</span>
          <h3>Avancer<br>à vos côtés.</h3>
          <p>Nous accompagnons la mise en œuvre des décisions retenues et réexaminons avec vous votre situation lorsqu’elle évolue.</p>
        </li>
      </ol>
      <p class="approach__note">Lorsque votre situation le demande, nous travaillons avec vos notaires, avocats et experts-comptables.</p>
    </div>
  </section>

  <section class="associates section-space" id="associes" aria-labelledby="associates-title">
    <div class="container-wide associates__inner">
      <div class="associates__intro">
        <p class="eyebrow">Les associés</p>
        <h2 id="associates-title" class="section-title">Des personnes<br>à qui parler.</h2>
        <p>Fabien, Sabine et Marine sont vos interlocuteurs au cabinet. Vous pouvez leur écrire directement pour faire connaissance ou poursuivre un échange.</p>
        <span class="associates__location">Paris, 3<sup>e</sup> arrondissement</span>
      </div>
      <ul class="associates__list">
        {associates.map(({ name, role, mailto }) => (
          <li>
            <a href={'mailto:' + mailto} aria-label={'Écrire à ' + name}>
              <span class="associates__identity">
                <span class="associates__role">{role}</span>
                <span class="associates__name">{name}</span>
                <span class="associates__email">{mailto}</span>
              </span>
              <span class="associates__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="container-wide contact__inner">
      <div class="contact__copy">
        <p class="eyebrow">Faisons connaissance</p>
        <h2 id="contact-title" class="section-title">Tout commence<br>par une conversation.</h2>
        <p>Au cabinet ou en visioconférence, un premier rendez-vous permet de faire le point sur votre demande, sans engagement.</p>
        <a href="mailto:contact@berger-associes.fr" class="button-link">Nous écrire <span aria-hidden="true">↗</span></a>
      </div>
      <div class="contact__address">
        <p class="contact__address-label">Nous rencontrer à Paris</p>
        <address><span class="contact__street-number">96</span><span>boulevard Sébastopol<br>75003 Paris</span></address>
        <a class="text-link" href="https://www.google.com/maps/search/?api=1&amp;query=96+boulevard+Sebastopol+75003+Paris" target="_blank" rel="noopener noreferrer" aria-label="Voir l’itinéraire sur Google Maps, nouvel onglet">Voir l’itinéraire <span aria-hidden="true">↗</span></a>
        <a class="contact__email" href="mailto:contact@berger-associes.fr">contact@berger-associes.fr</a>
      </div>
    </div>
  </section>
</BaseLayout>
