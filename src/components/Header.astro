---
import Brand from './Brand.astro';
const navItems = [
  { href: '/#cabinet', label: 'Le cabinet' },
  { href: '/#approche', label: 'Notre approche' },
  { href: '/#associes', label: 'Les associés' },
  { href: '/#contact', label: 'Nous rencontrer' },
];
---
<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Berger & Associés — retour à l'accueil"><Brand tone="light" tagline /></a>
    <nav class="desktop-nav" aria-label="Navigation principale">
      <ul>{navItems.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
    <details class="mobile-nav">
      <summary>Menu <span aria-hidden="true" class="mobile-nav__icon"></span></summary>
      <nav aria-label="Navigation principale mobile">
        <ul>{navItems.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(246,244,239,.97); border-bottom: 1px solid var(--c-divider); }
  .site-header__inner { position: relative; min-height: 104px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .site-header__brand { text-decoration: none; flex: none; }
  .site-header__brand:hover { opacity: 1; }
  nav ul { list-style: none; display: flex; align-items: center; gap: 2rem; }
  nav a { color: var(--c-fg); font-size: .78rem; font-weight: 500; text-decoration: none; display: inline-block; padding-block: .7rem; }
  nav a:hover { color: var(--c-accent); opacity: 1; }
  .desktop-nav li:last-child a { border: 1px solid #A4A9A8; padding: .75rem 1.05rem; margin-left: .5rem; }
  .mobile-nav { display: none; }
  .mobile-nav summary { display: flex; gap: .65rem; align-items: center; cursor: pointer; list-style: none; font-size: .75rem; padding: .8rem 0 .8rem .8rem; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary:focus-visible { outline: 2px solid var(--c-accent); outline-offset: 4px; }
  .mobile-nav__icon { width: 16px; height: 8px; border-block: 1px solid currentColor; }
  .mobile-nav[open] .mobile-nav__icon { border-bottom: 0; transform: rotate(-45deg); height: 1px; }
  .mobile-nav nav { position: absolute; inset: 100% 0 auto; padding: 1rem var(--page-gutter) 1.5rem; background: var(--c-ivoire); border-bottom: 1px solid var(--c-divider); }
  .mobile-nav ul { display: block; }
  .mobile-nav li + li { border-top: 1px solid var(--c-divider); }
  .mobile-nav nav a { display: block; padding-block: 1rem; font-size: .95rem; }
  @media (max-width: 1050px) { .desktop-nav { display: none; } .mobile-nav { display: block; } .site-header__inner { min-height: 88px; gap: 1rem; } }
  @media (max-width: 480px) { .site-header__inner { min-height: 80px; } }
</style>
