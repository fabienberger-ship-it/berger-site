---
import Brand from './Brand.astro';

const navItems = [
  { href: '/#associes', label: 'Les associés' },
  { href: '/#contact', label: 'Nous rencontrer' },
];
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Berger & Associés — retour à l'accueil">
      <Brand tone="light" tagline />
    </a>

    <nav aria-label="Navigation principale" class="site-header__navwrap">
      <ul class="site-header__nav">
        {navItems.map(({ href, label }) => (
          <li>
            <a href={href} class="site-header__link">{label}</a>
          </li>
        ))}
        <li>
          <a href="mailto:contact@berger-associes.fr" class="btn btn--navy site-header__cta">
            Nous écrire
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--c-divider);
    background: rgba(250, 246, 236, 0.88);
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 76px;
    padding-block: var(--s-2);
    gap: var(--s-4);
  }

  .site-header__brand {
    text-decoration: none;
    flex: none;
  }

  .site-header__nav {
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--s-4);
    font-size: var(--fs-sm);
  }

  .site-header__link {
    color: var(--c-fg-muted);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: 0.02em;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard);
  }

  .site-header__link:hover {
    color: var(--c-fg);
    border-bottom-color: var(--c-gold);
    opacity: 1;
  }

  .site-header__cta { padding: 0.55em 1.3em; }

  @media (max-width: 720px) {
    .site-header__inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--s-2);
      padding-block: var(--s-2);
      min-height: 0;
    }
    .site-header__nav { gap: var(--s-3); }
    .site-header__cta { display: none; }
  }
</style>
