---
// Wordmark typographique seul — pas de monogramme tant que le SVG définitif
// du graphiste n'est pas livré. Net à toute résolution, aucun artifice.
interface Props {
  tone?: 'light' | 'dark'; // light = sur fond ivoire, dark = sur fond navy
  tagline?: boolean;
}

const { tone = 'light', tagline = false } = Astro.props;
---

<span class:list={['brand', `brand--${tone}`]}>
  <span class="brand__word">Berger <span class="brand__amp">&amp;</span> Associés</span>
  {tagline && <span class="brand__tagline">Conseil en gestion de patrimoine</span>}
</span>

<style>
  .brand {
    display: inline-flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .brand__word {
    font-family: var(--ff-serif);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: 0.015em;
    line-height: 1;
    white-space: nowrap;
  }

  .brand__amp { color: var(--c-gold); }

  .brand--light .brand__word { color: var(--c-navy); }
  .brand--dark .brand__word { color: var(--c-ivoire); }

  .brand__tagline {
    font-family: var(--ff-sans);
    font-size: 0.575rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand--light .brand__tagline { color: var(--c-fg-muted); }
  .brand--dark .brand__tagline { color: var(--c-gold); }
</style>
